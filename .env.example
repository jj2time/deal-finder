# Copy this file to .env and fill in the keys you have. Never commit .env.

# Apify (https://console.apify.com/account/integrations) - for the Rightmove/Zoopla scraper actors
APIFY_TOKEN=

# PropertyData (https://propertydata.co.uk/api) - optional, used for rent estimates
PROPERTYDATA_API_KEY=

# Mailbox that receives your Rightmove/Zoopla email alerts (optional)
# Gmail: use an App Password, host imap.gmail.com
ALERTS_IMAP_HOST=
ALERTS_IMAP_USER=
ALERTS_IMAP_PASSWORD=

# Sending deal alert emails (optional). Gmail: smtp.gmail.com, port 587, App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
